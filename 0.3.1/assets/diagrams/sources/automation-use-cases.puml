@startuml automation-use-cases
!include _theme.iuml
left to right direction

actor "CI/CD\nworkflow" as Automation
actor "TypeScript\napplication" as Consumer

rectangle "Octoform 0.3.1 · automated and embedded use" {
  package "Automation goals" {
    usecase "Run scheduled\nobservation" as Scheduled
    usecase "Validate policy in a\npull request" as PullRequest
    usecase "Run protected\nnon-interactive apply" as ProtectedApply
  }
  package "Reused governance capabilities" {
    usecase "Audit repository\nmetadata" as Audit
    usecase "Preview desired-state\nchanges" as Plan
    usecase "Confirm and apply\na displayed plan" as Apply
  }
  usecase "Embed configuration and\nplanning services" as Embed
}

Automation --> Scheduled
Automation --> PullRequest
Automation --> ProtectedApply
Consumer --> Embed
Scheduled ..> Audit : <<include>>
PullRequest ..> Plan : <<include>>
ProtectedApply ..> Apply : <<include>>
@enduml
