@startuml repository-selection
!include _theme.iuml

start
:Detect whether owner is organization or user;
if (Personal owner equals authenticated user?) then (yes)
  :List authenticated user's repositories;
else (no)
  :List repositories exposed for configured owner;
endif
:Normalize repository inventory;
:Remove exact names in exclude.repos;
if (--repo supplied?) then (yes)
  :Keep exact repository name;
endif
:Resolve explicit or custom-property type;
if (--type supplied?) then (yes)
  :Keep repositories with matching resolved type;
endif
if (Repository archived?) then (yes)
  :Keep observable metadata;\nsuppress desired-state mutation;
elseif (Effective manage is false?) then (yes)
  :Keep audit visibility;\nsuppress desired-state mutation;
else (no)
  :Observe fields required by effective policy;
endif
stop
@enduml
