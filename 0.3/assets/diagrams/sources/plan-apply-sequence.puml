@startuml plan-apply-sequence
!include _theme.iuml
hide footbox

actor Operator
participant "CLI apply command" as CLI
participant "Configuration resolver" as Config
participant "plan()" as Plan
participant "GitHub client" as Client
participant "GitHub REST API" as GitHub
participant "planRepo()" as Planner
participant "Change applier" as Applier

Operator -> CLI : octoform apply [filters]
CLI -> Config : loadConfig(path)
Config --> CLI : normalized Config
CLI -> Client : create client and check classic scopes
Client -> GitHub : GET /user
GitHub --> Client : authenticated identity and headers
CLI -> Plan : plan(..., quiet: true)
Plan -> Client : detect owner and list repositories
Client -> GitHub : discovery requests
GitHub --> Client : repositories and owner evidence

loop each selected repository
  Plan -> Config : resolvePolicy(config, repository)
  Config --> Plan : effective PolicySet
  Plan -> Client : read only policy-relevant state
  Client -> GitHub : repository, capability and resource GETs
  GitHub --> Client : observed state or unreadable evidence
  Client --> Plan : RepositoryDetail
  Plan -> Planner : planRepo(detail, policy, capabilities)
  Planner --> Plan : executable and blocked Change[]
end

Plan --> CLI : one computed plan
CLI -> Operator : show executable changes and blocked count

alt no executable changes
  CLI --> Operator : nothing to apply
else confirmation declined
  Operator --> CLI : no
  CLI --> Operator : aborted; no mutation
else confirmed or protected --yes
  Operator --> CLI : yes
  loop each repository
    CLI -> Applier : already displayed Change[]
    Applier -> GitHub : ordered, endpoint-grouped mutations
    GitHub --> Applier : success or API error
    Applier --> CLI : AppliedChange[]
  end
  CLI --> Operator : per-change outcomes and exit code
end
@enduml
