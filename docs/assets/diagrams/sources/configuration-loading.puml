@startuml configuration-loading
!include _theme.iuml

start
:Resolve requested root path;
:Enter file on active import stack;
if (File already on active stack?) then (yes)
  :Report complete circular import chain;
  stop
endif
:Read and parse YAML;

while (Unprocessed import exists?) is (yes)
  :Resolve path relative to declaring file;
  :Load imported document recursively;
  :Merge normalized import over earlier imports;
endwhile (no)

:Resolve each seed-file source relative\nto the document that declared it;
:Overlay this document's own values;
:Leave file from active import stack;

if (Conflicting owners?) then (yes)
  :Reject composed configuration;
  stop
endif
if (Root owner missing?) then (yes)
  :Reject composed configuration;
  stop
endif
if (Repository references unknown type?) then (yes)
  :Reject composed configuration;
  stop
endif
:Return normalized Config;
stop
@enduml
