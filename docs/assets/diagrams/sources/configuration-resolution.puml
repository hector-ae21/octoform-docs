@startuml configuration-resolution
!include _theme.iuml

start
:Resolve the requested YAML path;
:Read and parse the file;
if (Import cycle?) then (yes)
  :Reject the configuration;
  stop
else (no)
endif

while (Unresolved import exists?) is (yes)
  :Resolve it relative to its declaring file;
  :Read its imports recursively;
  :Resolve seed-file paths relative\nto the declaring file;
  :Merge imported content in order;
endwhile (no)

:Overlay the requested file's own content;
if (Owner missing or conflicting?) then (yes)
  :Reject the configuration;
  stop
else (no)
endif
:Validate explicit repository type references;
:Return normalized Config;

partition "For each discovered repository" {
  :Start with defaults;
  :Overlay the resolved type policy;
  :Overlay repos.<name>;
  note right
    Scalars merge key by key.
    null cancels an inherited scalar.
    Declared collections replace inherited ones.
  end note
  if (Excluded?) then (yes)
    :Remove from processing;
  elseif (manage is false?) then (yes)
    :Keep visible to audit;\nskip policy planning;
  else (no)
    :Return effective PolicySet;
  endif
}
stop
@enduml
