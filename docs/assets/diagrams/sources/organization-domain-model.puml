@startuml organization-domain-model
!include _theme.iuml

class OrganizationPolicy {
  profile: OrganizationProfile
  members: OrganizationMemberPolicy
  properties: Map<name, PropertyDefinition>
  rulesets: OrganizationRulesetPolicy[]
  teams: Map<slug, TeamPolicy>
  roles: Map<name, RoleHolders>
}

class OrganizationProfile {
  name: string
  description: string
  company: string
  website: string
  location: string
  email: string
  twitter_username: string
}

class OrganizationMemberPolicy {
  base_permission: none | read | write | admin
  create_repositories: boolean
  create_public_repositories: boolean
  create_private_repositories: boolean
  create_internal_repositories: boolean
  fork_private_repositories: boolean
  create_pages: boolean
  web_commit_signoff_required: boolean
  deploy_keys_enabled: boolean
}

class PropertyDefinition {
  value_type: string | url | true_false | single_select | multi_select
  description: string
  required: boolean
  default_value: string | string[]
  allowed_values: string[]
  values_editable_by: org_actors | org_and_repo_actors
  mode: present | absent
}

class OrganizationRulesetPolicy {
  name: string
  enforcement: active | evaluate | disabled
  target_branches: string[]
  bypass: RulesetBypass[]
}

class RulesetRepositories {
  include: string[]
  exclude: string[]
  properties: RulesetPropertyMatch[]
  exclude_properties: RulesetPropertyMatch[]
  protected: boolean
}

class TeamPolicy {
  name: string
  description: string
  privacy: secret | closed
  notifications: boolean
  parent: slug
  rename_from: string[]
  mode: present | absent
}

class TeamMembership {
  maintainers: login[]
  members: login[]
  authoritative: boolean
}

class RoleHolders {
  users: login[]
  teams: slug[]
  authoritative: boolean
}

class PolicySet {
  access: AccessPolicy
  properties: Map<name, value>
}

class AccessPolicy {
  users: Map<login, level>
  teams: Map<slug, level>
}

OrganizationPolicy "1" *-- "0..1" OrganizationProfile
OrganizationPolicy "1" *-- "0..1" OrganizationMemberPolicy
OrganizationPolicy "1" *-- "0..*" PropertyDefinition : by name
OrganizationPolicy "1" *-- "0..*" OrganizationRulesetPolicy
OrganizationPolicy "1" *-- "0..*" TeamPolicy : by slug
OrganizationPolicy "1" *-- "0..*" RoleHolders : by role name
OrganizationRulesetPolicy "1" *-- "1" RulesetRepositories : which repositories
TeamPolicy "1" *-- "0..1" TeamMembership
TeamPolicy "0..*" --> "0..1" TeamPolicy : parent
RoleHolders "0..*" ..> "0..*" TeamPolicy : grants to
PolicySet "1" *-- "0..1" AccessPolicy
AccessPolicy "0..*" ..> "0..*" TeamPolicy : grants a repository to

note bottom of PropertyDefinition
  The organisation defines a property here.
  A repository answers it under its own
  <b>properties</b> map. Neither half can
  stand in for the other.
end note

note bottom of AccessPolicy
  Declared from the repository side, including
  team grants: one grant, one place to read it.
end note
@enduml
