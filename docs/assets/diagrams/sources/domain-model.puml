@startuml domain-model
!include _theme.iuml

class Configuration {
  owner
  imports
  classify
  audit
}

class PolicySet {
  manage
  features
  merge
  security
  default_branch
  ensure_branches
}

class RulesetPolicy {
  name
  target_branches
  required_approvals
  block_force_push
}

class EnvironmentPolicy {
  name
  reviewers
}

class FilePolicy {
  path
  from
  mode
}

class RepositoryState {
  name
  visibility
  default_branch
}

class RepositoryDetail {
  settings
  structure
}

class RepositoryStructure {
  environments
  rulesets
  branches
}

class Change {
  repository
  key
  from
  to
  blocked
  warning
}

class AppliedChange {
  outcome
  error
}

Configuration "1" *-- "1..*" PolicySet : resolves
PolicySet "1" *-- "0..*" RulesetPolicy
PolicySet "1" *-- "0..*" EnvironmentPolicy
PolicySet "1" *-- "0..*" FilePolicy
RepositoryState <|-- RepositoryDetail
RepositoryDetail "1" *-- "0..1" RepositoryStructure
Change <|-- AppliedChange
PolicySet ..> Change : desired state
RepositoryDetail ..> Change : observed state
@enduml
